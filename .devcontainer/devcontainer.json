// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/rust
{
	"name": "slashstep-server",
	"build": {
		"dockerfile": "Containerfile"
	},
	"containerEnv": {
		"RUSTFLAGS": "-C linker=clang -C link-arg=-fuse-ld=mold"
	},
	"postStartCommand": "git config --global --add safe.directory ${containerWorkspaceFolder}; podman system service --time 0 &",
	"postCreateCommand": "sh ${containerWorkspaceFolder}/scripts/generate-json-web-token-key-pairs.sh; sh ${containerWorkspaceFolder}/scripts/generate-opensearch-initial-admin-password.sh; sh ${containerWorkspaceFolder}/scripts/generate-opensearch-certificates.sh",
	"mounts": [
		"type=bind,source=${localEnv:HOME}${localEnv:USERPROFILE}/.ssh,target=/home/vscode/.ssh,readonly"
	],
	// "privileged": true,
	"customizations": {
		"vscode": {
			"extensions": [
				"github.vscode-github-actions",
				"vadimcn.vscode-lldb",
				"rust-lang.rust-analyzer",
				"ms-azuretools.vscode-containers"
			],
			"settings": {
				"dev.containers.dockerPath": "podman",
				"dev.containers.dockerComposePath": "podman-compose",
				"containers.containerClient": "com.microsoft.visualstudio.containers.podman",
				"containers.orchestratorClient": "com.microsoft.visualstudio.orchestrators.podmancompose"
			}
		}
	},
	"runArgs": [
		"--device=/dev/fuse",
		"--security-opt", "label=disable",
		"--security-opt", "unmask=/proc/*",
		"--cap-add=SYS_ADMIN",
		"--device=/dev/net/tun"
	],
	"forwardPorts": [
		3001
	]
}
